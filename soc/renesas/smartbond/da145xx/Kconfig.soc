config SOC_SERIES_DA145XX
	bool
	select SOC_FAMILY_RENESAS_SMARTBOND
	help
	  Renesas SmartBond(tm) DA145xx series MCU

config SOC_DA14531
	bool
	select SOC_SERIES_DA145XX
	help
	  Renesas DA14531

config SOC_DA14585
	bool
	select SOC_SERIES_DA145XX
	help
	  Renesas DA14585

config SOC_DA14586
	bool
	select SOC_SERIES_DA145XX
	help
	  Renesas DA14586

config SOC_SERIES
	default "da145xx" if SOC_SERIES_DA145XX

config SOC
	default "da14531" if SOC_DA14531
	default "da14585" if SOC_DA14585
	default "da14586" if SOC_DA14586
