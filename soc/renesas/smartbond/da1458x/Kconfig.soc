config SOC_SERIES_DA1458X
	bool
	select SOC_FAMILY_RENESAS_SMARTBOND
	help
	  Renesas SmartBond(tm) DA1458x series MCU

config SOC_DA14585
	bool
	select SOC_SERIES_DA1458X
	help
	  Renesas DA14585

config SOC_DA14586
	bool
	select SOC_SERIES_DA1458X
	help
	  Renesas DA14586

config SOC_SERIES
	default "da1458x" if SOC_SERIES_DA1458X

config SOC
	default "da14585" if SOC_DA14585
	default "da14586" if SOC_DA14586
